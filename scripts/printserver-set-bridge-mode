#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-}"
case "$MODE" in
    auth|open) ;;
    *) echo "usage: $0 auth|open" >&2; exit 2 ;;
esac

CONFIG_DIR=/etc/printserver
TOKEN_MARKER="$CONFIG_DIR/bridge-token-mode"
OLD_OPEN_MARKER="$CONFIG_DIR/bridge-open"

if [[ "$MODE" == "auth" ]]; then
    touch "$TOKEN_MARKER"
    chmod 0644 "$TOKEN_MARKER"
    rm -f "$OLD_OPEN_MARKER"
    echo "[bridge-mode] auth (HMAC handshake required)"
else
    rm -f "$TOKEN_MARKER" "$OLD_OPEN_MARKER"
    echo "[bridge-mode] open (no HMAC handshake)"
fi

systemctl restart printserver-bridge.service
