#!/usr/bin/env bash
set -euo pipefail
umask 0077

STATE_DIR=/var/lib/printserver
CRED_DIR="$STATE_DIR/credentials"
CONFIG_DIR=/etc/printserver
FLAG="$CONFIG_DIR/firstboot.flag"
LOG=/var/log/printserver-firstboot.log
PRINT_USER=printserver
PRINT_GROUP=printserver
TOOL=/usr/bin/printserver-tool

log() {
    local ts
    ts="$(date -Iseconds)"
    printf '[%s] %s\n' "$ts" "$*" >> "$LOG"
    printf '[firstboot] %s\n' "$*"
}

[[ -f "$FLAG" ]] || { log "no firstboot.flag, nothing to do"; exit 0; }

# Credenciais nunca vão para o log. Começar limpo também evita carregar o
# histórico de outra imagem para o equipamento atual.
: > "$LOG"
chmod 0600 "$LOG"

log "starting"

install -d -o root -g root -m 0755 "$CONFIG_DIR"
install -d -o root -g "$PRINT_GROUP" -m 0750 "$STATE_DIR"
install -d -o "$PRINT_USER" -g "$PRINT_GROUP" -m 0700 "$CRED_DIR"

PRESEED=""
for candidate in /boot/firmware/printserver-preseed.json /boot/printserver-preseed.json; do
    if [[ -f "$candidate" ]]; then
        PRESEED="$candidate"
        log "using preseed $PRESEED"
        break
    fi
done

if [[ -f "$CONFIG_DIR/device.json" ]]; then
    DEVICE_ID="$("$TOOL" device-id "$CONFIG_DIR/device.json")"
    log "device identity preserved"
elif [[ -n "$PRESEED" ]]; then
    python3 -c "import json,sys;d=json.load(open(sys.argv[1]))['device'];open(sys.argv[2],'w').write(json.dumps(d,indent=2))" \
        "$PRESEED" "$CONFIG_DIR/device.json"
    chmod 0644 "$CONFIG_DIR/device.json"
    DEVICE_ID="$("$TOOL" device-id "$CONFIG_DIR/device.json")"
else
    DEVICE_ID="$("$TOOL" init-identity "$CONFIG_DIR/device.json" | tail -1)"
    chmod 0644 "$CONFIG_DIR/device.json"
fi

SUFFIX="${DEVICE_ID#PS-}"
SUFFIX="${SUFFIX: -4}"
SUFFIX="${SUFFIX,,}"
NEW_HOSTNAME="printserver-${SUFFIX}"
printf '%s\n' "$NEW_HOSTNAME" > /etc/hostname
hostname "$NEW_HOSTNAME"
# Substituir só a linha do nosso hostname; não descartar aliases que
# outras ferramentas tenham acrescentado depois da primeira execução.
HOSTS_TMP=/etc/hosts.printserver.tmp.$$
awk -v h="$NEW_HOSTNAME" '
    $1 == "127.0.1.1" && NF > 1 && ($2 == h || $2 ~ /^printserver-/) {
        print "127.0.1.1\t" h
        next
    }
    { print }
' /etc/hosts > "$HOSTS_TMP"
if ! grep -qF "127.0.1.1	${NEW_HOSTNAME}" "$HOSTS_TMP"; then
    printf '127.0.1.1\t%s\n' "$NEW_HOSTNAME" >> "$HOSTS_TMP"
fi
cat "$HOSTS_TMP" > /etc/hosts
rm -f "$HOSTS_TMP"
log "hostname set to $NEW_HOSTNAME"

# Só a primeira instalação volta ao padrão. Se o cartão já tem estado,
# preservar a escolha do operador, inclusive o modo de impressão.
HAD_STATE=0
[[ -s "$CRED_DIR/portal-admin" ]] && HAD_STATE=1

if [[ "$HAD_STATE" -eq 0 ]]; then
    rm -f "$CONFIG_DIR/bridge-token-mode" "$CONFIG_DIR/bridge-open"
fi

# Gravar segredos em arquivo temporário e renomear: uma queda de energia
# não deixa um arquivo meio escrito com o dono errado.
write_secret() {
    local dest="$1"
    local tmp="${dest}.tmp.$$"
    cat > "$tmp"
    chown "$PRINT_USER":"$PRINT_GROUP" "$tmp"
    chmod 0600 "$tmp"
    mv -f "$tmp" "$dest"
}

# Um hash Argon2 truncado não serve. Tratar como ausente para não travar
# o painel com uma senha que nunca mais pode ser verificada.
ADMIN_OK=0
if [[ -s "$CRED_DIR/portal-admin" ]] && grep -q '^\$argon2id\$v=' "$CRED_DIR/portal-admin"; then
    ADMIN_OK=1
fi

if [[ "$ADMIN_OK" -eq 1 ]]; then
    chown "$PRINT_USER":"$PRINT_GROUP" "$CRED_DIR/portal-admin"
    chmod 0600 "$CRED_DIR/portal-admin"
    log "admin password preserved"
else
    HASH="$(printf '%s\n' 'printserver' | "$TOOL" hash-password)"
    printf '%s\n' "$HASH" | write_secret "$CRED_DIR/portal-admin"
    install -o "$PRINT_USER" -g "$PRINT_GROUP" -m 0600 /dev/null "$CRED_DIR/first-run.flag"
    log "admin password set to initial value"
    log "first-run flag set"
fi

if [[ -s "$CRED_DIR/hotspot-password" ]]; then
    chown "$PRINT_USER":"$PRINT_GROUP" "$CRED_DIR/hotspot-password"
    chmod 0600 "$CRED_DIR/hotspot-password"
    log "hotspot password preserved"
else
    printf '%s\n' 'printserver' | write_secret "$CRED_DIR/hotspot-password"
    log "hotspot password set"
fi

if [[ -s "$CRED_DIR/bridge-token" ]]; then
    chown "$PRINT_USER":"$PRINT_GROUP" "$CRED_DIR/bridge-token"
    chmod 0600 "$CRED_DIR/bridge-token"
    log "bridge token preserved"
else
    openssl rand -hex 32 | write_secret "$CRED_DIR/bridge-token"
    log "bridge token created"
fi

if [[ -s "$CRED_DIR/portal-cert.pem" && -s "$CRED_DIR/portal-key.pem" ]]; then
    chown "$PRINT_USER":"$PRINT_GROUP" "$CRED_DIR/portal-cert.pem" "$CRED_DIR/portal-key.pem"
    chmod 0600 "$CRED_DIR/portal-key.pem"
    chmod 0644 "$CRED_DIR/portal-cert.pem"
    log "tls certificate preserved"
else
    PRIMARY_IP="$(hostname -I | awk '{print $1}')"
    SAN="subjectAltName=DNS:$NEW_HOSTNAME.local,DNS:$NEW_HOSTNAME,DNS:printserver.local,IP:10.42.0.1"
    if [[ -n "$PRIMARY_IP" ]]; then
        SAN="${SAN},IP:${PRIMARY_IP}"
    fi
    CERT_TMP="$CRED_DIR/portal-cert.pem.tmp.$$"
    KEY_TMP="$CRED_DIR/portal-key.pem.tmp.$$"
    openssl req -x509 -newkey rsa:2048 -nodes \
        -out "$CERT_TMP" \
        -keyout "$KEY_TMP" \
        -subj "/CN=$NEW_HOSTNAME.local" \
        -addext "$SAN" \
        -days 3650 >/dev/null 2>&1
    chown "$PRINT_USER":"$PRINT_GROUP" "$CERT_TMP" "$KEY_TMP"
    chmod 0600 "$KEY_TMP"
    chmod 0644 "$CERT_TMP"
    mv -f "$CERT_TMP" "$CRED_DIR/portal-cert.pem"
    mv -f "$KEY_TMP" "$CRED_DIR/portal-key.pem"
fi
PORTAL_FP="$("$TOOL" fingerprint-sha256 "$CRED_DIR/portal-cert.pem")"

# Só a primeira instalação troca as chaves do host. Uma reexecução do
# firstboot não pode invalidar a confiança de quem já acessou por SSH.
if [[ "$HAD_STATE" -eq 0 ]]; then
    rm -f /etc/ssh/ssh_host_*
    if command -v ssh-keygen >/dev/null; then
        ssh-keygen -A
    fi
fi

install -d -o "$PRINT_USER" -g "$PRINT_GROUP" -m 0750 "$CRED_DIR/enterprise-ca"

log "device id: $DEVICE_ID"
log "hostname: $NEW_HOSTNAME.local"
log "hotspot ssid: PrintServer-${DEVICE_ID: -4}"
log "tls sha-256: $PORTAL_FP"

if [[ -n "$PRESEED" ]]; then
    shred -u -n 1 "$PRESEED" 2>/dev/null || rm -f "$PRESEED"
    log "preseed shredded from boot partition"
fi

for f in /boot/firmware/user-data /boot/user-data; do
    if [[ -f "$f" ]]; then
        shred -u -n 1 "$f" 2>/dev/null || rm -f "$f"
        log "cloud-init user-data shredded from $f"
    fi
done
if command -v cloud-init >/dev/null 2>&1; then
    cloud-init clean --logs --machine-id >/dev/null 2>&1 || true
fi
rm -rf /var/lib/cloud/instances/*/user-data* 2>/dev/null || true

rm -f "$FLAG"
log "firstboot complete"
