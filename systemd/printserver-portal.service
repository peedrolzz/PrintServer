[Unit]
Description=PrintServer Portal (HTTPS setup UI)
After=network.target printserver-firstboot.service
Wants=network.target

[Service]
Type=simple
User=printserver
Group=printserver
# Portal must bind :443 without sudo. We grant CAP_NET_BIND_SERVICE as ambient.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/printserver-portal --listen=0.0.0.0:443
Restart=always
RestartSec=3

# Hardening (V03/V04/V16/V17/V22/V23)
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/printserver /run/printserver
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
UMask=0077

LimitNOFILE=256
TasksMax=32
MemoryMax=64M

[Install]
WantedBy=multi-user.target
