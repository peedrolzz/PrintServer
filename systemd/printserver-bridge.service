[Unit]
Description=PrintServer Bridge (TCP -> USB)
After=network-online.target printserver-firstboot.service modprobe@usblp.service
Wants=network-online.target modprobe@usblp.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=printserver
Group=lp
SupplementaryGroups=printserver
ExecStart=/usr/bin/printserver-bridge --config=/etc/printserver/printers.json --bind=0.0.0.0
Restart=always
RestartSec=3

# Hardening (V01/V09/V17/V23)
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
# Sem filtro de device cgroup. O allow-list por grupo ou major não resolve
# de forma confiável quando o módulo usblp carrega depois do start, e um
# DevicePolicy=closed com lista vazia derruba a impressão. O acesso ao
# dispositivo continua restrito pela regra udev (root:lp, 0660) e pelo grupo
# do serviço; o restante do hardening permanece ativo.
ProtectSystem=strict
ReadWritePaths=/var/lib/printserver /run/printserver
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

LimitNOFILE=512
TasksMax=64
MemoryMax=96M

[Install]
WantedBy=multi-user.target
